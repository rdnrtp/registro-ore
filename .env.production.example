# =============================================================================
# Configurazione di PRODUZIONE del Registro ore (server VPS).
#
# NON modificare questo file: è il modello. Sul server si crea il file vero con
#     ./deploy/genera-segreti.sh
# che copia questo file in .env.production, riempie da solo le password e le
# chiavi segnate "SOSTITUISCI_CON_genera-segreti" e lo rende leggibile solo
# dal proprietario. Poi si apre .env.production con
#     nano .env.production
# e si sostituisce ogni valore che contiene ancora "SOSTITUISCI".
#
# .env.production contiene segreti: non va su git, non va inviato per email,
# e una copia va conservata nel gestore di password (vedi RUNBOOK.md).
# Se resta un valore di esempio, l'API si rifiuta di partire e dice quale.
# =============================================================================


# ----------------------------------------------------------------- Indirizzo

# Nome a dominio dell'app, senza https:// e senza barra finale.
# Esempio: ore.nomeimpianto.it
# Deve già puntare all'indirizzo IP del server (record DNS A, ed eventualmente AAAA).
DOMINIO=SOSTITUISCI.esempio.it

# Email a cui Let's Encrypt scrive se il certificato HTTPS ha problemi
# (di solito la tua). Non viene mostrata agli utenti.
ACME_EMAIL=SOSTITUISCI@esempio.it


# ----------------------------------------------------------------- Database

# Nome del database e dell'utente PostgreSQL: lasciali così.
POSTGRES_DB=registro_ore
POSTGRES_USER=registro_ore
# Password del database: la genera lo script. Non cambiarla dopo il primo
# avvio (PostgreSQL la registra solo alla creazione del database).
POSTGRES_PASSWORD=SOSTITUISCI_CON_genera-segreti


# ----------------------------------------------------------------- Accesso

# Chiave che firma le sessioni degli utenti: la genera lo script.
# Se la cambi, tutti gli utenti devono rifare l'accesso (nient'altro).
JWT_SECRET=SOSTITUISCI_CON_genera-segreti

# Durata della sessione in ore (168 = 7 giorni).
JWT_DURATA_ORE=168

# Validità in ore dei link di invito creati dall'amministratore.
INVITO_DURATA_ORE=72

# Tentativi di accesso falliti ammessi in una finestra di tempo: per la
# stessa email da uno stesso indirizzo, e in totale da uno stesso indirizzo.
LOGIN_FINESTRA_MINUTI=15
LOGIN_MAX_FALLITI_PER_EMAIL=5
LOGIN_MAX_FALLITI_PER_IP=30

# "Password dimenticata?" nella pagina di accesso: validità del link in
# minuti e richieste ammesse nella finestra, per email e per indirizzo.
RESET_DURATA_MINUTI=60
RESET_FINESTRA_MINUTI=60
RESET_MAX_PER_EMAIL=3
RESET_MAX_PER_IP=10


# ----------------------------------------------------------------- Posta (SMTP)
# Dati forniti dal servizio di invio email scelto (sezione "SMTP" del suo
# pannello). Il server deve accettare connessioni cifrate: porta 587 con
# STARTTLS (SMTP_SECURE=false) oppure porta 465 con TLS (SMTP_SECURE=true).

# Nome del server SMTP. Esempio: smtp.fornitore.eu
SMTP_HOST=SOSTITUISCI_server_smtp
SMTP_PORT=587
SMTP_SECURE=false
# Utente e password SMTP (spesso una "chiave API" creata nel pannello del servizio).
SMTP_USER=SOSTITUISCI_utente_smtp
SMTP_PASSWORD=SOSTITUISCI_password_smtp

# Indirizzo da cui partono le email dell'app. Deve essere di un dominio
# verificato presso il servizio SMTP (SPF, DKIM, DMARC: vedi RUNBOOK.md).
# Il nome visualizzato lo sceglie l'app ("Mario Rossi tramite Registro ore").
# Esempio: registro-ore@ore.nomeimpianto.it
POSTA_MITTENTE=registro-ore@SOSTITUISCI.esempio.it

# Tentativi per ogni email prima di segnarla in errore (ritardi crescenti, fino a un'ora).
POSTA_MAX_TENTATIVI=8

# Facoltativa: dimensione massima (MB) del PDF delle spese allegato all'email
# alla segreteria. Predefinita 4 (Brevo: allegati "sotto i 4 MB", 20 MB in
# tutto per email). Alzarla solo dopo una prova (RUNBOOK.md, spese).
# SPESE_MAX_PDF_MB=4

# Chi riceve gli avvisi tecnici del server (backup fallito). Di solito la tua email.
ALLARMI_EMAIL=SOSTITUISCI@esempio.it


# ----------------------------------------------------------------- Notifiche push
# Coppia di chiavi VAPID: si crea con ./deploy/genera-chiavi-push.sh, che
# stampa le due righe da copiare qui (RUNBOOK.md, 6.4). La privata è un
# segreto. Se le cambi, ognuno dovrà riattivare le notifiche dall'app.
# Senza chiavi valide l'API si rifiuta di partire.
VAPID_PUBLIC_KEY=SOSTITUISCI_con_genera-chiavi-push
VAPID_PRIVATE_KEY=SOSTITUISCI_con_genera-chiavi-push


# ----------------------------------------------------------------- Backup
# Vedi RUNBOOK.md, "Backup". Lo script deploy/backup.sh legge queste righe.

# Cartella del server dove restano le copie (7 giornaliere, 4 settimanali,
# 6 mensili). La crea deploy/installa-servizi.sh.
BACKUP_DIR=/var/backups/registro-ore

# Chiave PUBBLICA di cifratura dei backup (inizia con "age1"). La coppia di
# chiavi si crea con ./deploy/crea-chiave-backup.sh; la chiave PRIVATA NON va
# sul server: va nel gestore di password e su carta (vedi RUNBOOK.md).
BACKUP_CHIAVE_PUBBLICA=SOSTITUISCI_age1...

# Copia fuori dal server (con rclone). Lasciala vuota solo finché non hai
# scelto il fornitore: in quel caso ogni backup lo ricorda nel log.
# Formato: remoto:<percorso>. Il nome "remoto" corrisponde alle variabili
# RCLONE_CONFIG_REMOTO_* qui sotto. Esempi:
#   remoto:nome-bucket/registro-ore          (spazio compatibile S3)
#   remoto:backup/registro-ore               (SFTP: cartella sul server remoto)
BACKUP_REMOTO=

# --- Se il fornitore è compatibile S3 (togli il # davanti alle righe):
# RCLONE_CONFIG_REMOTO_TYPE=s3
# Provider: Other va bene per quasi tutti; alcuni hanno un nome proprio
# (es. Scaleway, Wasabi, Hetzner, Cloudflare, IDrive, Backblaze → usa "Other" se non sei sicuro).
# RCLONE_CONFIG_REMOTO_PROVIDER=Other
# RCLONE_CONFIG_REMOTO_ENDPOINT=SOSTITUISCI_https://s3.regione.fornitore.eu
# RCLONE_CONFIG_REMOTO_REGION=SOSTITUISCI_regione
# RCLONE_CONFIG_REMOTO_ACCESS_KEY_ID=SOSTITUISCI_chiave_di_accesso
# RCLONE_CONFIG_REMOTO_SECRET_ACCESS_KEY=SOSTITUISCI_chiave_segreta
# Non creare il bucket da qui (deve già esistere):
# RCLONE_CONFIG_REMOTO_NO_CHECK_BUCKET=true

# --- Se il fornitore è un server SFTP (togli il # davanti alle righe):
# RCLONE_CONFIG_REMOTO_TYPE=sftp
# RCLONE_CONFIG_REMOTO_HOST=SOSTITUISCI_nome.del.server
# RCLONE_CONFIG_REMOTO_PORT=22
# RCLONE_CONFIG_REMOTO_USER=SOSTITUISCI_utente
# Chiave SSH creata apposta (vedi RUNBOOK.md); il percorso è dentro il container di rclone.
# RCLONE_CONFIG_REMOTO_KEY_FILE=/chiavi/backup_sftp
# Impronta del server remoto (vedi RUNBOOK.md), per non collegarsi a un impostore:
# RCLONE_CONFIG_REMOTO_KNOWN_HOSTS_FILE=/chiavi/known_hosts

# Facoltativo: indirizzo da "chiamare" dopo ogni backup riuscito (es. un
# controllo di healthchecks.io). Se il backup non arriva, il servizio avvisa:
# copre anche il caso in cui il backup non parta proprio. Vuoto = niente.
BACKUP_PING_URL=
