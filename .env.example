# Copia questo file in .env e cambia i valori. Il file .env non va su git.

# Porta del computer (o del VPS) su cui si apre l'app nel browser.
HTTP_PORT=8080

# Database PostgreSQL. Usa una password lunga e casuale.
POSTGRES_DB=registro_ore
POSTGRES_USER=registro_ore
POSTGRES_PASSWORD=cambia-questa-password

# Chiave per firmare i token di accesso: almeno 32 caratteri casuali.
# Per generarne una: docker run --rm node:24-alpine node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-questa-chiave-con-almeno-32-caratteri-casuali

# Durata della sessione in ore (168 = 7 giorni).
JWT_DURATA_ORE=168

# true solo se l'app è servita in HTTPS (in produzione sul VPS).
COOKIE_SECURE=false

# Numero di proxy davanti all'API: 1 = solo il nginx del frontend.
# Sul VPS, con un ulteriore proxy HTTPS davanti, diventa 2.
TRUST_PROXY=1

# Limite ai tentativi di login falliti, per finestra di tempo.
LOGIN_FINESTRA_MINUTI=15
LOGIN_MAX_FALLITI_PER_EMAIL=5
LOGIN_MAX_FALLITI_PER_IP=30
