# Copia questo file in .env e cambia i valori. Il file .env non va su git.

# Porta del computer (o del VPS) su cui si apre l'app nel browser.
HTTP_PORT=8088

# Database PostgreSQL. Usa una password lunga e casuale.
POSTGRES_DB=registro_ore
POSTGRES_USER=registro_ore
POSTGRES_PASSWORD=cambia-questa-password

# Chiave per firmare i token di accesso: almeno 32 caratteri casuali.
# Per generarne una: docker run --rm node:24-alpine node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-questa-chiave-con-almeno-32-caratteri-casuali

# Durata della sessione in ore (168 = 7 giorni).
JWT_DURATA_ORE=168

# Validità in ore dei link di invito creati dall'amministratore (72 = 3 giorni).
INVITO_DURATA_ORE=72

# true solo se l'app è servita in HTTPS (in produzione sul VPS).
COOKIE_SECURE=false

# Numero di proxy davanti all'API: 1 = solo il nginx del frontend.
# Sul VPS, con un ulteriore proxy HTTPS davanti, diventa 2.
TRUST_PROXY=1

# Limite ai tentativi di login falliti, per finestra di tempo.
LOGIN_FINESTRA_MINUTI=15
LOGIN_MAX_FALLITI_PER_EMAIL=5
LOGIN_MAX_FALLITI_PER_IP=30

# "Password dimenticata?" nella pagina di accesso: validità del link in
# minuti e richieste ammesse nella finestra, per email e per indirizzo.
RESET_DURATA_MINUTI=60
RESET_FINESTRA_MINUTI=60
RESET_MAX_PER_EMAIL=3
RESET_MAX_PER_IP=10

# Indirizzo dell'app come lo aprono gli utenti: serve per i link nelle email.
# Per aprire i link dal telefono sulla stessa rete: http://<IP del PC>:8088
APP_URL=http://localhost:8088

# Posta in uscita (SMTP). In sviluppo resta tutto vuoto: le email vanno alla
# casella finta Mailpit del Compose, visibile su http://localhost:8025
# (MAILPIT_PORT). Il servizio vero si configura nella Fase 6.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# Indirizzo del mittente; il nome cambia ("Andrea Petris tramite Registro ore").
POSTA_MITTENTE=registro-ore@localhost
# Tentativi per ogni email prima di segnarla in errore (ritardi crescenti, fino a un'ora).
POSTA_MAX_TENTATIVI=8
MAILPIT_PORT=8025
